# ============================================================
# Plantilla de configuración
#
# Copiar este archivo como ".env" en la misma carpeta y completar
# los valores. El .env real no se sube al repositorio.
# ============================================================

# Base de datos
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=gestion_turnos
DB_PORT=3306

# Clave con la que se firman los tokens de sesión.
# Poner una cadena larga y propia.
JWT_SECRET=

# Dirección donde se sirven las páginas, para armar los enlaces
# que se mandan por correo.
FRONTEND_URL=http://localhost:3000
